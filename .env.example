# Скопируй этот файл в .env и впиши свои ключи. Файл .env никому не пересылай.

# Расшифровка: основной способ (бесплатно ~8 часов аудио в день) – console.groq.com → API Keys
GROQ_API_KEY=

# Запасные способы расшифровки (можно оставить пустыми)
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Telegram-бот для сценариев – @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Модели Claude (по умолчанию: оценка – haiku, сценарии – sonnet; с подпиской Max можно opus)
# SCORE_MODEL=haiku
# WRITE_MODEL=sonnet
